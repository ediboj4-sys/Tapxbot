<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Farm & Earn</title>

<script src="https://telegram.org/js/telegram-web-app.js"></script>
<!-- ✅ ADSGRAM SDK - Required for all ad features -->
<script src="https://sad.adsgram.ai/js/sad.min.js"></script>
<!-- Supabase JS (UMD) -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js/dist/umd/supabase.min.js"></script>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  background: linear-gradient(180deg, #2d5a3d 0%, #1a3a24 100%);
  color:white;
  font-family:'Arial', sans-serif;
  padding:10px;
  overflow-x:hidden;
  padding-bottom:100px;
}

/* HEADER */
.header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:12px;
  background:rgba(0,0,0,0.3);
  border-radius:12px;
  margin-bottom:12px;
}

.logo{
  font-size:20px;
  font-weight:bold;
  color:#00ff88;
}

.level-badge{
  background:#ff6b00;
  padding:6px 12px;
  border-radius:20px;
  font-size:12px;
  font-weight:bold;
}

/* FARM CANVAS */
.farm-container{
  position:relative;
  width:100%;
  height:280px;
  background: linear-gradient(180deg, #4a7c59 0%, #2d5a3d 100%);
  border-radius:16px;
  overflow:hidden;
  margin-bottom:12px;
  border:2px solid #00ff88;
  box-shadow:0 4px 15px rgba(0,255,136,0.2);
}

.farm-background{
  position:absolute;
  top:0;
  left:0;
  width:100%;
  height:100%;
  background-image:
    repeating-linear-gradient(90deg, #3a6a4a 0px, #3a6a4a 40px, transparent 40px, transparent 80px),
    repeating-linear-gradient(0deg, #3a6a4a 0px, #3a6a4a 40px, transparent 40px, transparent 80px);
  opacity:0.5;
}

.farm-content{
  position:relative;
  z-index:2;
  width:100%;
  height:100%;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-direction:column;
}

.tap-zone{
  width:100px;
  height:100px;
  background:radial-gradient(circle, #ffeb3b, #ffc107);
  border-radius:50%;
