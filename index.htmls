,<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Farm & Earn</title>

<script src="https://telegram.org/js/telegram-web-app.js"></script>
<!-- ✅ ADSGRAM SDK - Required for all ad features -->
<script src="https://sad.adsgram.ai/js/sad.min.js"></script>
<!-- Supabase JS (UMD) -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js/dist/umd/supabase.min.js"></script>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  background: linear-gradient(180deg, #2d5a3d 0%, #1a3a24 100%);
  color:white;
  font-family:'Arial', sans-serif;
  padding:10px;
  overflow-x:hidden;
  padding-bottom:100px;
}

/* HEADER */
.header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:12px;
  background:rgba(0,0,0,0.3);
  border-radius:12px;
  margin-bottom:12px;
}

.logo{
  font-size:20px;
  font-weight:bold;
  color:#00ff88;
}

.level-badge{
  background:#ff6b00;
  padding:6px 12px;
  border-radius:20px;
  font-size:12px;
  font-weight:bold;
}

/* FARM CANVAS */
.farm-container{
  position:relative;
  width:100%;
  height:280px;
  background: linear-gradient(180deg, #4a7c59 0%, #2d5a3d 100%);
  border-radius:16px;
  overflow:hidden;
  margin-bottom:12px;
  border:2px solid #00ff88;
  box-shadow:0 4px 15px rgba(0,255,136,0.2);
}

.farm-background{
  position:absolute;
  top:0;
  left:0;
  width:100%;
  height:100%;
  background-image:
    repeating-linear-gradient(90deg, #3a6a4a 0px, #3a6a4a 40px, transparent 40px, transparent 80px),
    repeating-linear-gradient(0deg, #3a6a4a 0px, #3a6a4a 40px, transparent 40px, transparent 80px);
  opacity:0.5;
}

.farm-content{
  position:relative;
  z-index:2;
  width:100%;
  height:100%;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-direction:column;
}

.tap-zone{
  width:100px;
  height:100px;
  background:radial-gradient(circle, #ffeb3b, #ffc107);
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:50px;
  cursor:pointer;
  box-shadow:0 8px 20px rgba(255,235,59,0.4);
  transition:all 0.1s;
  user-select:none;
}

.tap-zone:active{
  transform:scale(0.85);
  box-shadow:0 3px 10px rgba(255,235,59,0.2);
}

.tap-count{
  position:absolute;
  top:10px;
  left:10px;
  background:rgba(0,0,0,0.6);
  padding:8px 14px;
  border-radius:20px;
  font-size:12px;
}

.farm-level{
  position:absolute;
  bottom:10px;
  left:10px;
  background:linear-gradient(135deg, #0066ff, #00ccff);
  padding:8px 14px;
  border-radius:12px;
  font-size:12px;
  font-weight:bold;
}

.crops{
  position:absolute;
  bottom:20px;
  left:20px;
  display:flex;
  gap:8px;
  font-size:24px;
}

.crop{
  animation:sway 3s ease-in-out infinite;
}

.crop:nth-child(2){
  animation-delay:0.5s;
}

.crop:nth-child(3){
  animation-delay:1s;
}

@keyframes sway{
  0%, 100%{ transform:rotate(0deg); }
  50%{ transform:rotate(3deg); }
}

/* STATS GRID */
.stats-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin-bottom:12px;
}

.stat-card{
  background:rgba(0,0,0,0.4);
  border:1px solid #00ff88;
  padding:14px;
  border-radius:12px;
  text-align:center;
}

.stat-card h3{
  font-size:11px;
  opacity:0.7;
  margin-bottom:6px;
}

.stat-card .value{
  font-size:24px;
  font-weight:bold;
  color:#00ff88;
}

.stat-card .sub{
  font-size:10px;
  opacity:0.6;
  margin-top:4px;
}

/* PROGRESS */
.progress-section{
  background:rgba(0,0,0,0.4);
  border:1px solid #00ff88;
  padding:12px;
  border-radius:12px;
  margin-bottom:12px;
}

.progress-section h3{
  font-size:12px;
  margin-bottom:8px;
  display:flex;
  justify-content:space-between;
}

.progress-bar{
  width:100%;
  height:8px;
  background:rgba(255,255,255,0.1);
  border-radius:10px;
  overflow:hidden;
}

.progress-fill{
  height:100%;
  background:linear-gradient(90deg, #00ff88, #00ccff);
  width:0%;
  transition:width 0.3s;
}

/* NAVIGATION TABS */
.nav-tabs{
  display:flex;
  gap:8px;
  margin-bottom:12px;
  background:rgba(0,0,0,0.3);
  padding:8px;
  border-radius:12px;
  overflow-x:auto;
}

.nav-tab{
  flex:1;
  min-width:80px;
  padding:10px;
  border:none;
  border-radius:8px;
  background:transparent;
  color:white;
  cursor:pointer;
  font-size:12px;
  font-weight:bold;
  transition:all 0.3s;
  white-space:nowrap;
}

.nav-tab.active{
  background:linear-gradient(135deg, #00ff88, #00ccff);
  color:#000;
}

/* SECTIONS */
.section{
  display:none;
}

.section.active{
  display:block;
}

.section-content{
  background:rgba(0,0,0,0.4);
  border:1px solid #00ff88;
  padding:14px;
  border-radius:12px;
}

.section-content h2{
  font-size:14px;
  margin-bottom:12px;
  color:#00ff88;
  display:flex;
  align-items:center;
  gap:8px;
}

.btn{
  width:100%;
  padding:12px;
  border:none;
  border-radius:10px;
  background:linear-gradient(135deg, #00ff88, #00ccff);
  color:#000;
  font-weight:bold;
  cursor:pointer;
  font-size:13px;
  transition:all 0.2s;
  margin-top:10px;
}

.btn:active{
  transform:scale(0.95);
}

.btn:disabled{
  opacity:0.5;
  cursor:not-allowed;
}

input, select{
  width:100%;
  padding:10px;
  border:none;
  border-radius:8px;
  background:rgba(0,0,0,0.5);
  color:white;
  margin-top:8px;
  border:1px solid #00ff88;
  font-size:12px;
}

input::placeholder{
  color:rgba(255,255,255,0.5);
}

.input-group{
  margin-bottom:8px;
}

.label{
  font-size:11px;
  opacity:0.7;
  display:block;
  margin-bottom:4px;
}

/* EARNINGS CARD */
.earnings-card{
  background:linear-gradient(135deg, #ff6b00, #ff8f00);
  padding:16px;
  border-radius:12px;
  margin-bottom:12px;
  text-align:center;
}

.earnings-card .label{
  opacity:0.9;
  color:white;
}

.earnings-card .value{
  font-size:32px;
  font-weight:bold;
  color:white;
  margin:8px 0;
}

.earnings-card .sub{
  font-size:11px;
  opacity:0.8;
}

/* WITHDRAWAL OPTIONS */
.withdraw-options{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
  margin-bottom:12px;
}

.withdraw-option{
  background:rgba(0,0,0,0.5);
  border:2px solid #00ff88;
  padding:12px;
  border-radius:10px;
  text-align:center;
  cursor:pointer;
  transition:all 0.2s;
  font-size:12px;
}

.withdraw-option.selected{
  background:linear-gradient(135deg, #00ff88, #00ccff);
  color:#000;
  font-weight:bold;
}

.withdraw-option:active{
  transform:scale(0.95);
}

/* POPUP */
#popup{
  position:fixed;
  top:0;
  left:0;
  width:100%;
  height:100%;
  background:rgba(0,0,0,0.9);
  display:none;
  justify-content:center;
  align-items:center;
  z-index:9999;
  padding:20px;
}

.popup-content{
  background:linear-gradient(135deg, #1a3a24, #2d5a3d);
  border:2px solid #00ff88;
  border-radius:16px;
  padding:20px;
  max-width:90%;
  text-align:center;
  box-shadow:0 0 30px rgba(0,255,136,0.3);
}

.popup-content h2{
  margin-bottom:12px;
